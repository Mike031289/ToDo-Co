{% extends 'base.html.twig' %}
{% block body %}
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <h2>
                Créer une nouvelle tâche
            </h2>
            <hr>
                {# Opening the form and setting the submission target URL #}
                {{ form_start(form, {'action' : path('task_create')}) }}
                {# 1. Title Field Group #}
                <div class="form-group">
                    <label for="task_title" class="control-label required">
                        Titre de la tâche
                    </label>
                    <input type="text" id="task_title" name="task[title]" required="required" class="form-control" placeholder="Enter title..." value="{{ form.title.vars.value }}">
                        {{ form_errors(form.title) }}
                    </div>
                    {# 2. Content Field Group (Textarea) #}
                    <div class="form-group">
                        <label for="task_content" class="control-label required">
                            Contenu détaillé
                        </label>
                        <textarea id="task_content" name="task[content]" required="required" class="form-control" placeholder="Décrivez la tâche" rows="8">
                            {% if form.content.vars.value is defined %}
                                {{ form.content.vars.value }}
                            {% endif %}</textarea>
                        {{ form_errors(form.content) }}
                    </div>
                    <br>
                        {# 3. Action Buttons and CSRF Security Token #}
                        <div class="form-group">
                            {# Manually rendering the CSRF token to prevent form_rest from bringing back corrupted fields #}
                            {{ form_widget(form._token) }}
                            <button type="submit" class="btn btn-success">
                                Ajouter la tâche
                            </button>
                            <a href="{{ path('task_list') }}" class="btn btn-default">
                                Retour à la liste
                            </a>
                        </div>
                        {# DISABLE AUTOMATIC RENDERING OF REMAINING FIELDS HERE #}
                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                </div>
            {% endblock %}
